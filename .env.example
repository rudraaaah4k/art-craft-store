# Pooled PostgreSQL URL for application runtime (Neon/Supabase dashboard)
DATABASE_URL="postgresql://user:password@pooler.example.com:5432/art-craft?sslmode=require"
# Direct PostgreSQL URL for Prisma CLI migrations (Neon/Supabase direct connection)
DIRECT_URL="postgresql://user:password@direct.example.com:5432/art-craft?sslmode=require"
# Auth.js signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-auth-string"
# Public application URL used by Auth.js callbacks
AUTH_URL="http://localhost:3000"
# Optional Google OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Optional Cloudinary credentials from the Cloudinary dashboard
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
# Optional Razorpay credentials from the Razorpay dashboard
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Optional Shiprocket credentials from the Shiprocket dashboard
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"
# Optional Resend API key from the Resend dashboard
RESEND_API_KEY="your-resend-api-key"
